{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffra.net/schemas/record-entry-v1.schema.json",
  "title": "Diffra Record Entry v1",
  "description": "One line of a job's entries file, written by `diffra record`. An entry states a value for one dataset, or that the dataset was skipped, that its collector failed, or that what was given was rejected. See docs/record.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "dataset", "commit", "job", "status"],
  "properties": {
    "schema": {
      "const": "https://diffra.net/schemas/record-entry-v1.schema.json"
    },
    "project": {
      "$ref": "#/$defs/name"
    },
    "dataset": {
      "description": "The dataset name as the command line gave it. A rejected entry may name a dataset the root file does not declare.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "job": {
      "$ref": "#/$defs/job"
    },
    "dimensions": {
      "description": "The value of each dimension the dataset is stratified by, for this job.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "key": {
      "description": "The member of a keyed dataset this value belongs to. Absent for an unkeyed dataset.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": ["recorded", "skipped", "failed", "rejected"]
    },
    "replaces": {
      "description": "True when `--replace` was given: this entry replaces an earlier one for the same dataset, key and dimensions in the same job.",
      "const": true
    },
    "value": {
      "$ref": "#/$defs/scalar"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "data": {
      "description": "The typed values a converter read from the source, in the shape of the dataset's type."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "recorded" } }, "required": ["status"] },
      "then": {
        "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["problems"] }] },
        "oneOf": [
          { "required": ["value"], "not": { "anyOf": [{ "required": ["source"] }, { "required": ["data"] }] } },
          { "required": ["source", "data"], "not": { "required": ["value"] } }
        ]
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["skipped", "failed"] } }, "required": ["status"] },
      "then": {
        "required": ["reason"],
        "not": { "anyOf": [{ "required": ["value"] }, { "required": ["source"] }, { "required": ["data"] }, { "required": ["problems"] }, { "required": ["replaces"] }] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
      "then": {
        "required": ["problems"],
        "not": { "anyOf": [{ "required": ["data"] }, { "required": ["reason"] }] }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "job": {
      "description": "Which CI job wrote the entry. The CLI takes it from the command line or the environment and does not ask the CI host.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attempt": {
          "description": "The attempt number when the CI host re-runs a job. A later attempt replaces an earlier one when fragments are merged.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scalar": {
      "description": "One value given with `--value`, in canonical form: a decimal string with no exponent, no leading plus sign and no superfluous zeros.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "source": {
      "description": "The file a value was read from. Raw files are not kept unless asked for; the digest identifies what was read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "description": "Relative to the working directory, with forward slashes.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "not": { "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$)|\\\\)" }
        },
        "format": {
          "description": "The converter that read it, as named in the dataset's `from`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
