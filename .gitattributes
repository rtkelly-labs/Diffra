# Normalise to LF everywhere. Fixture digests are taken over LF bytes,
# so CRLF checkouts (core.autocrlf=true on Windows) break SampleFixtureTests.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.bundle binary

# Fuzz regression inputs are raw bytes.
tests/Protocol.Fuzz/regressions/** binary

# Regression corpus files are exact byte fixtures and must not undergo line-ending normalization.
tests/regression/0.0.1-alpha.1/** -text
