{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffra.dev/schemas/coverage-v1.schema.json",
  "title": "Diffra Standardized Code Coverage Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "methodology", "summary", "files"],
  "properties": {
    "schema": { "const": "https://diffra.dev/schemas/coverage-v1.schema.json" },
    "scope": { "type": "string", "minLength": 1 },
    "methodology": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "branches", "methods"],
      "properties": {
        "lines": { "$ref": "#/$defs/counter" },
        "branches": { "$ref": "#/$defs/counter" },
        "methods": { "$ref": "#/$defs/counter" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "lines", "branches", "uncoveredLineRanges"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
          },
          "lines": { "$ref": "#/$defs/counter" },
          "branches": { "$ref": "#/$defs/counter" },
          "uncoveredLineRanges": {
            "type": "string",
            "pattern": "^(?:|(?:[0-9]+(?:-[0-9]+)?)(?:, [0-9]+(?:-[0-9]+)?)*)$"
          }
        }
      }
    }
  },
  "$defs": {
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "missed", "rate"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "missed": { "type": "integer", "minimum": 0 },
        "rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    }
  }
}
