<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Diffra.Cli</AssemblyName>
    <RootNamespace>Diffra.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>diffra</ToolCommandName>
    <PackageId>Diffra.Cli</PackageId>
    <Description>Typed evidence, trusted baselines, and reviewable change CLI.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Converters/Diffra.Converters.csproj" />
    <ProjectReference Include="../Protocol/Diffra.Protocol.csproj" />
    <ProjectReference Include="../RootFile/Diffra.RootFile.csproj" />
  </ItemGroup>
</Project>
