{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffra.dev/schemas/cloudevent-diffra-v1.schema.json",
  "title": "Diffra CloudEvent Envelope v1",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "dataschema", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/digest" },
    "source": { "type": "string", "format": "uri" },
    "type": {
      "enum": [
        "dev.diffra.evidence.v1",
        "dev.diffra.delta.v1",
        "dev.diffra.assessment.v1"
      ]
    },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri" },
    "subject": { "type": "string" },
    "data": { "type": "object" },
    "diffraoutcome": { "enum": ["pass", "warn", "fail"] },
    "diffradeltastatus": { "type": "string" },
    "diffragithash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "diffragitbranch": { "type": "string" },
    "diffragithubpr": { "type": "integer", "minimum": 1 },
    "traceparent": { "type": "string" },
    "tracestate": { "type": "string" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
